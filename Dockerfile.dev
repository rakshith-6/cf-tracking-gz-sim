# =============================================================================
# DEV image for cf-tracking-gz-sim 

# This is a bare ROS 2 Jazzy + Gazebo Harmonic + GUI environment helped me to bind mount 
# the repo over /ws and /sim at `docker run` time and build/edit interactively inside the
# container during development.

# Use the real Dockerfile (COPY-based, self-contained, no mounts needed) for quick use.
# =============================================================================

ARG BASE_DIGEST=sha256:31daab66eef9139933379fb67159449944f4e2dcf2e22c2d12cc715f29873e0f
FROM ros:jazzy-ros-base-noble@${BASE_DIGEST}

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends locales \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-ros-gz \
        ros-jazzy-tf2-tools \
        ros-jazzy-xacro \
        ros-jazzy-robot-state-publisher \
        python3-numpy \
        python3-scipy \
        python3-pandas \
        python3-matplotlib \
        python3-seaborn \
        python3-colcon-common-extensions \
        python3-rosdep \
        git \
        vim \
        nano \
        mesa-utils \
        x11-apps \
        xauth \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true && rosdep update

ENV XDG_RUNTIME_DIR=/tmp/runtime-gz
RUN mkdir -p /tmp/runtime-gz && chmod 700 /tmp/runtime-gz

RUN mkdir -p /ws/src /sim
WORKDIR /ws

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
