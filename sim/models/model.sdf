<?xml version="1.0" ?>

<!--
This is a variant of the official model.sdf from Bitcraze Crazyflie (MIT License, Copyright (c) 2024 Bitcraze).

Refer for original model (https://github.com/bitcraze/crazyflie-simulation/tree/main/simulator_files/gazebo/crazyflie)

1. MulticopterVelocityControl plugin was removed - controllers I am testing (Lee / Mellinger / MPC) will directly 
   command rotor speeds.
2. Each motor plugin MulticopterMotorModel now subscribes to topic /crazyflie/command/motor_speed instead of receiving 
   commands from the removed velocity controller.
3. IMU sensor added on the body link (250 Hz, topic /crazyflie/imu).

maximumLinearAcceleration and other limits lived in the removed velocity-control plugin
So our my own cf tracking controller will enfore accel/tilt and saturation limits.
-->

<sdf version="1.8">
  <model name="crazyflie_tracking">
    
    <link name="crazyflie/body">
      <pose> 0 0 17.425E-3 0 0 0</pose>
      
      <enable_wind>true</enable_wind>
      
      <inertial>
        <mass>0.0283</mass>
        <inertia>
          <ixx>16.571710E-06</ixx>
          <iyy>16.655602E-06</iyy>
          <izz>29.261652E-06</izz>
          <ixy>0.830806E-06</ixy>
          <ixz>0.718277E-06</ixz>
          <iyz>1.800197E-06</iyz>
        </inertia>
      </inertial>

      <collision name="crazyflie/body_collision">
        <geometry>
          <box>
            <size>0.10 0.10 34.850E-3</size>
          </box>
        </geometry>
      </collision>
      
      <visual name="crazyflie/body_visual">
        <geometry>
          <mesh>
            <uri>meshes/cf2_assembly.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Added the IMU sensor which will publish gyro and accelerometer 
      readings at /crazyflie/imu topic and controller will subscribes to this-->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <topic>/crazyflie/imu</topic>
      </sensor>
    </link>
    
    <link name="crazyflie/m1_prop">
      <pose>0.031 -0.031 0.021 0 0 0</pose>
      
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      
      <visual name="crazyflie/m1_visual">
        <geometry>
          <mesh>
            <uri>meshes/ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual> 
    </link>

    <link name="crazyflie/m2_prop">
      <pose>-0.031 -0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m2_visual">
        <geometry>
          <mesh>
            <uri>meshes/cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="crazyflie/m3_prop">
      <pose>-0.031 0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m3_visual">
        <geometry>
          <mesh>
            <uri>meshes/ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="crazyflie/m4_prop">
      <pose>0.031 0.031 0.021 0 0 0</pose>
      <inertial>
        <mass>0.0008</mass>
        <inertia>
          <ixx>8.33333E-09</ixx>
          <iyy>1.08333E-07</iyy>
          <izz>1.13333E-07</izz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m4_visual">
        <geometry>
          <mesh>
            <uri>meshes/cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="crazyflie/m1_joint" type="revolute">
      <child>crazyflie/m1_prop</child>
      <parent>crazyflie/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <joint name="crazyflie/m2_joint" type="revolute">
      <child>crazyflie/m2_prop</child>
      <parent>crazyflie/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <joint name="crazyflie/m3_joint" type="revolute">
      <child>crazyflie/m3_prop</child>
      <parent>crazyflie/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <joint name="crazyflie/m4_joint" type="revolute">
      <child>crazyflie/m4_prop</child>
      <parent>crazyflie/body</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>crazyflie</robotNamespace>
      <jointName>crazyflie/m1_joint</jointName>
      <linkName>crazyflie/m1_prop</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <!--Changed motorConstant and rotorDragCoefficient. The motor subscribes to 
      command/motor_speed topic-->
      <motorConstant>2.076e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>1.1e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>0</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>crazyflie</robotNamespace>
      <jointName>crazyflie/m2_joint</jointName>
      <linkName>crazyflie/m2_prop</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>2.076e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>1.1e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>1</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>crazyflie</robotNamespace>
      <jointName>crazyflie/m3_joint</jointName>
      <linkName>crazyflie/m3_prop</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>2.076e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>1.1e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>2</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>crazyflie</robotNamespace>
      <jointName>crazyflie/m4_joint</jointName>
      <linkName>crazyflie/m4_prop</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>2618</maxRotVelocity>
      <motorConstant>2.076e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>1.1e-06</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <actuator_number>3</actuator_number>
      <motorType>velocity</motorType>
    </plugin>
    
    <!-- Joint state publisher publishes joint velocity = rotor speed
    real rotor speed = rotor speed * rotorVelocitySlowdownSim(20)
    The OdometryPublisher publishes pos, ori, linear and angular vel
    -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>250</odom_publish_frequency>
    </plugin>
  
  </model>
</sdf>